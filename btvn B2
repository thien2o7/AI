      "source": [
        "import numpy as np\n",
        "import skfuzzy as fuzz\n",
        "from skfuzzy import control as ctrl\n",
        "\n",
        "# --- BƯỚC 1: ĐỊNH NGHĨA CÁC BIẾN ---\n",
        "# Các biến đầu vào (Sử dụng thang đo chung 0-100% cho dễ chuẩn hóa)\n",
        "density = ctrl.Antecedent(np.arange(0, 101, 1), 'density')\n",
        "urgency = ctrl.Antecedent(np.arange(0, 101, 1), 'urgency')\n",
        "load = ctrl.Antecedent(np.arange(0, 101, 1), 'load')\n",
        "traffic = ctrl.Antecedent(np.arange(0, 101, 1), 'traffic')\n",
        "profit = ctrl.Antecedent(np.arange(0, 101, 1), 'profit')\n",
        "\n",
        "# Các biến đầu ra\n",
        "combine = ctrl.Consequent(np.arange(0, 11, 1), 'combine')   # 0-10 đơn hàng\n",
        "priority = ctrl.Consequent(np.arange(0, 101, 1), 'priority') # 0-100% mức độ ưu tiên\n",
        "\n",
        "# --- BƯỚC 2: THIẾT LẬP TẬP MỜ (MEMBERSHIP FUNCTIONS) ---\n",
        "# Thiết lập chung cho 5 biến đầu vào và biến Mức độ ưu tiên\n",
        "for var in [density, urgency, load, traffic, profit, priority]:\n",
        "    var['thap'] = fuzz.trimf(var.universe, [0, 0, 45])\n",
        "    var['trung_binh'] = fuzz.trimf(var.universe, [30, 50, 70])\n",
        "    var['cao'] = fuzz.trimf(var.universe, [55, 100, 100])\n",
        "\n",
        "# Thiết lập riêng cho biến Số lượng đơn hàng (Combine)\n",
        "combine['it'] = fuzz.trimf(combine.universe, [0, 0, 3])\n",
        "combine['mot_so'] = fuzz.trimf(combine.universe, [2, 4, 6])\n",
        "combine['nhieu'] = fuzz.trimf(combine.universe, [5, 10, 10])\n",
        "\n",
        "# --- BƯỚC 3: HỆ THỐNG 8 LUẬT MỜ (Trang 93) ---\n",
        "# Luật kết hợp đơn hàng (1-5)\n",
        "rule1 = ctrl.Rule(density['cao'] & load['thap'] & traffic['trung_binh'], combine['nhieu']) # Modified traffic['thap'] to traffic['trung_binh']\n",
        "rule2 = ctrl.Rule(density['trung_binh'] & traffic['cao'] & urgency['trung_binh'], combine['mot_so'])\n",
        "rule3 = ctrl.Rule(load['cao'] & density['cao'] & profit['trung_binh'], combine['mot_so'])\n",
        "rule4 = ctrl.Rule(density['thap'] & urgency['cao'] & traffic['trung_binh'], combine['mot_so'])\n",
        "rule5 = ctrl.Rule(profit['cao'] & urgency['cao'] & traffic['cao'], combine['mot_so'])\n",
        "\n",
        "# Luật ưu tiên giao hàng (6-8)\n",
        "rule6 = ctrl.Rule(urgency['cao'] & profit['cao'], priority['cao'])\n",
        "rule7 = ctrl.Rule(urgency['trung_binh'] & traffic['trung_binh'], priority['trung_binh'])\n",
        "rule8 = ctrl.Rule(urgency['thap'] & density['cao'] & profit['thap'], priority['thap'])\n",
        "\n",
        "# --- BƯỚC 4: VẬN HÀNH HỆ THỐNG ---\n",
        "delivery_ctrl = ctrl.ControlSystem([rule1, rule2, rule3, rule4, rule5, rule6, rule7, rule8])\n",
        "delivery_sim = ctrl.ControlSystemSimulation(delivery_ctrl)\n",
        "\n",
        "# Nạp dữ liệu tình huống thử nghiệm (Cuối trang 93)\n",
        "delivery_sim.input['density'] = 85      # Mật độ: Cao\n",
        "delivery_sim.input['urgency'] = 50      # Khẩn cấp: Trung bình\n",
        "delivery_sim.input['load'] = 20         # Tải trọng: Thấp\n",
        "delivery_sim.input['traffic'] = 50      # Giao thông: Trung bình\n",
        "delivery_sim.input['profit'] = 50       # Lợi nhuận: Trung bình\n",
        "\n",
        "# Thực thi tính toán\n",
        "delivery_sim.compute()\n",
        "\n",
        "# In kết quả\n",
        "print(\"--- KẾT QUẢ TỐI ƯU GIAO HÀNG (2.14) ---\")\n",
        "print(f\"Số lượng đơn hàng nên kết hợp: ~ {int(round(delivery_sim.output['combine']))} đơn hàng\")\n",
        "print(f\"Mức độ ưu tiên giao tuyến này: {delivery_sim.output['priority']:.2f}% (Thuộc nhóm Trung bình)\")\n",
        "\n",
        "# Xem biểu đồ\n",
        "combine.view(sim=delivery_sim)\n",
        "priority.view(sim=delivery_sim)\n"
