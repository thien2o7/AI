        "#BT 2.11\n",
        "import numpy as np\n",
        "import skfuzzy as fuzz\n",
        "from skfuzzy import control as ctrl\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# ========== 1. Định nghĩa các biến ngôn ngữ ==========\n",
        "\n",
        "# --- Đầu vào ---\n",
        "# Quãng đường (km)\n",
        "distance = ctrl.Antecedent(np.arange(0, 51, 1), 'distance')\n",
        "# Tình trạng giao thông (%)\n",
        "traffic = ctrl.Antecedent(np.arange(0, 101, 1), 'traffic')\n",
        "# Mức cầu (%)\n",
        "demand = ctrl.Antecedent(np.arange(0, 101, 1), 'demand')\n",
        "# Điều kiện thời tiết (thang điểm 0-10)\n",
        "weather = ctrl.Antecedent(np.arange(0, 11, 1), 'weather')\n",
        "# Đánh giá của khách hàng (1-5)\n",
        "rating = ctrl.Antecedent(np.arange(1, 5.1, 0.1), 'rating')\n",
        "# Đúng giờ (%)\n",
        "punctuality = ctrl.Antecedent(np.arange(0, 101, 1), 'punctuality')\n",
        "\n",
        "# --- Đầu ra ---\n",
        "# Giá chuyến đi (đơn vị quy ước 0-100)\n",
        "price = ctrl.Consequent(np.arange(0, 101, 1), 'price')\n",
        "# Điểm thưởng cho tài xế (0-10)\n",
        "bonus = ctrl.Consequent(np.arange(0, 11, 1), 'bonus')\n",
        "\n",
        "# ========== 2. Định nghĩa hàm liên thuộc ==========\n",
        "\n",
        "# Quãng đường\n",
        "distance['Short'] = fuzz.trimf(distance.universe, [0, 0, 3])\n",
        "distance['Medium'] = fuzz.trimf(distance.universe, [2, 5, 8])\n",
        "distance['Long'] = fuzz.trimf(distance.universe, [6, 13, 20])\n",
        "distance['Very_Long'] = fuzz.trimf(distance.universe, [15, 32.5, 50])\n",
        "\n",
        "# Giao thông\n",
        "traffic['Low'] = fuzz.trimf(traffic.universe, [0, 0, 30])\n",
        "traffic['Medium'] = fuzz.trimf(traffic.universe, [20, 50, 70])\n",
        "traffic['High'] = fuzz.trimf(traffic.universe, [60, 100, 100])\n",
        "\n",
        "# Mức cầu\n",
        "demand['Low'] = fuzz.trimf(demand.universe, [0, 0, 30])\n",
        "demand['Medium'] = fuzz.trimf(demand.universe, [20, 50, 70])\n",
        "demand['High'] = fuzz.trimf(demand.universe, [60, 100, 100])\n",
        "\n",
        "# Thời tiết (0: tốt, 5: trung bình, 10: xấu)\n",
        "weather['Good'] = fuzz.trimf(weather.universe, [0, 0, 4])\n",
        "weather['Moderate'] = fuzz.trimf(weather.universe, [3, 5, 7])\n",
        "weather['Bad'] = fuzz.trimf(weather.universe, [6, 10, 10])\n",
        "\n",
        "# Đánh giá khách hàng\n",
        "rating['Poor'] = fuzz.trimf(rating.universe, [1, 1, 2.5])\n",
        "rating['Average'] = fuzz.trimf(rating.universe, [2, 3.5, 4])\n",
        "rating['Good'] = fuzz.trimf(rating.universe, [3.5, 5, 5])\n",
        "\n",
        "# Đúng giờ\n",
        "punctuality['Late'] = fuzz.trimf(punctuality.universe, [0, 0, 50])\n",
        "punctuality['On_Time'] = fuzz.trimf(punctuality.universe, [40, 60, 80])\n",
        "punctuality['Early'] = fuzz.trimf(punctuality.universe, [70, 100, 100])\n",
        "\n",
        "# Giá chuyến đi\n",
        "price['Low'] = fuzz.trimf(price.universe, [0, 0, 30])\n",
        "price['Medium'] = fuzz.trimf(price.universe, [20, 50, 70])\n",
        "price['High'] = fuzz.trimf(price.universe, [60, 80, 100])\n",
        "price['Very_High'] = fuzz.trimf(price.universe, [80, 100, 100])\n",
        "\n",
        "# Điểm thưởng\n",
        "bonus['None'] = fuzz.trimf(bonus.universe, [0, 0, 2])\n",
        "bonus['Few'] = fuzz.trimf(bonus.universe, [1, 3, 5])\n",
        "bonus['Moderate'] = fuzz.trimf(bonus.universe, [4, 6, 8])\n",
        "bonus['High'] = fuzz.trimf(bonus.universe, [7, 10, 10])\n",
        "\n",
        "# ========== 3. Định nghĩa các luật mờ (dựa trên tài liệu) ==========\n",
        "\n",
        "# --- Luật cho giá chuyến đi (1-10) ---\n",
        "rule1 = ctrl.Rule(distance['Short'] & traffic['Low'] & demand['Low'], price['Low'])\n",
        "rule2 = ctrl.Rule(distance['Short'] & traffic['Medium'] & demand['High'], price['Medium'])\n",
        "rule3 = ctrl.Rule(distance['Medium'] & traffic['High'] & demand['High'], price['High'])\n",
        "rule4 = ctrl.Rule(distance['Long'] & traffic['Medium'] & weather['Good'], price['Medium'])\n",
        "rule5 = ctrl.Rule(distance['Long'] & traffic['High'] & weather['Bad'], price['Very_High'])\n",
        "rule6 = ctrl.Rule(distance['Very_Long'] & traffic['High'] & demand['High'], price['Very_High'])\n",
        "rule7 = ctrl.Rule(distance['Medium'] & traffic['Low'] & demand['Low'], price['Medium'])\n",
        "rule8 = ctrl.Rule(distance['Short'] & traffic['High'] & weather['Bad'], price['High'])\n",
        "rule9 = ctrl.Rule(distance['Very_Long'] & weather['Bad'], price['Very_High'])\n",
        "rule10 = ctrl.Rule(distance['Medium'] & traffic['Medium'] & weather['Bad'], price['Medium'])\n",
        "\n",
        "# --- Luật cho điểm thưởng (11-20) ---\n",
        "rule11 = ctrl.Rule(rating['Good'] & punctuality['Early'], bonus['High'])\n",
        "rule12 = ctrl.Rule(rating['Average'] & punctuality['On_Time'], bonus['Moderate'])\n",
        "rule13 = ctrl.Rule(rating['Poor'] & punctuality['Late'], bonus['None'])\n",
        "rule14 = ctrl.Rule(distance['Long'] & traffic['High'] & punctuality['On_Time'], bonus['High'])\n",
        "rule15 = ctrl.Rule(distance['Medium'] & traffic['Medium'] & rating['Good'], bonus['Moderate'])\n",
        "rule16 = ctrl.Rule(rating['Poor'] & punctuality['Late'], bonus['None'])   # trùng ý nghĩa rule13\n",
        "rule17 = ctrl.Rule(distance['Very_Long'] & weather['Bad'] & rating['Good'], bonus['High'])\n",
        "rule18 = ctrl.Rule(distance['Short'] & rating['Average'] & punctuality['On_Time'], bonus['Few'])\n",
        "rule19 = ctrl.Rule(distance['Long'] & traffic['High'] & punctuality['Late'], bonus['Few'])\n",
        "rule20 = ctrl.Rule(distance['Medium'] & weather['Moderate'] & rating['Good'], bonus['Moderate'])\n",
        "\n",
        "# ========== 4. Xây dựng hệ thống điều khiển ==========\n",
        "price_ctrl = ctrl.ControlSystem([rule1, rule2, rule3, rule4, rule5, rule6, rule7, rule8, rule9, rule10])\n",
        "bonus_ctrl = ctrl.ControlSystem([rule11, rule12, rule13, rule14, rule15, rule16, rule17, rule18, rule19, rule20])\n",
        "\n",
        "price_sim = ctrl.ControlSystemSimulation(price_ctrl)\n",
        "bonus_sim = ctrl.ControlSystemSimulation(bonus_ctrl)\n",
        "\n",
        "# ========== 5. Mô phỏng với một bộ input cụ thể ==========\n",
        "\n",
        "price_sim.input['distance'] = 18    #quảng đường\n",
        "price_sim.input['traffic'] = 85     #giao thông\n",
        "price_sim.input['demand'] = 90      #nhu cầu\n",
        "price_sim.input['weather'] = 9      #thời tiết\n",
        "\n",
        "bonus_sim.input['distance'] = 18    #quảng đường\n",
        "bonus_sim.input['traffic'] = 85     #giao thông\n",
        "bonus_sim.input['weather'] = 9      #thời tiết\n",
        "bonus_sim.input['rating'] = 4.8     #đánh giá\n",
        "bonus_sim.input['punctuality'] = 85 #đúng giờ\n",
        "\n",
        "# Tính toán\n",
        "price_sim.compute()\n",
        "bonus_sim.compute()\n",
        "\n",
        "# In kết quả\n",
        "print(\"===== KẾT QUẢ SUY LUẬN MỜ =====\")\n",
        "print(f\"Giá chuyến đi (quy đổi): {price_sim.output['price']:.2f}\")\n",
        "print(f\"Điểm thưởng tài xế: {bonus_sim.output['bonus']:.2f}\")\n",
        "\n",
        "# ========== 6. Trực quan hóa (tuỳ chọn) ==========\n",
        "# Hiển thị hàm liên thuộc của một vài biến\n",
        "distance.view()\n",
        "traffic.view()\n",
        "weather.view()\n",
        "price.view()\n",
        "bonus.view()\n",
        "plt.show()"
      ],
