        "# Xếp hạng cửa hàng (Dựa sát theo text: <4 là Thấp, 4-4.5 là TB, >4.5 là Cao)\n",
        "rating['thap'] = fuzz.trapmf(rating.universe, [1, 1, 3.8, 4.0])\n",
        "rating['trung_binh'] = fuzz.trimf(rating.universe, [3.9, 4.25, 4.6])\n",
        "rating['cao'] = fuzz.trapmf(rating.universe, [4.4, 4.6, 5, 5])\n",
